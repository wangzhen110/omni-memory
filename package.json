{
  "name": "@local/omni-memory",
  "version": "4.6.3",
  "private": true,
  "type": "module",
  "description": "Omni Memory for any AI host: append-only transcripts, bi-temporal facts, self-verifying notes, hybrid retrieval, zero-config local semantic recall, project scoping and an interactive star map. Native DSH plugin, with MCP, HTTP, OpenAPI and CLI adapters.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzhen110/omni-memory.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "omni-memory",
    "ai-memory",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "openapi",
    "cli",
    "memory",
    "knowledge-base",
    "sqlite",
    "rag",
    "star-map"
  ],
  "main": "./index.js",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('.test-results.tap',{force:true})\"",
    "test": "node --test --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=.test-results.tap \"test/*.test.mjs\"",
    "verify": "npm test && node scripts/check-test-results.mjs && npm run check",
    "check:tests": "node scripts/check-test-results.mjs",
    "setup": "node scripts/install.mjs --apply --start --require-release",
    "setup:dev": "node scripts/install.mjs --apply --start",
    "setup:dry": "node scripts/install.mjs",
    "setup:dry:release": "node scripts/install.mjs --require-release",
    "doctor": "node hosts/cli.mjs doctor",
    "demo": "node scripts/demo.mjs",
    "qa": "node scripts/qa.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "mcp": "node hosts/mcp/bin.mjs",
    "serve": "node hosts/cli.mjs serve",
    "omni": "node hosts/cli.mjs",
    "memory:sync": "node scripts/reference-to-memory.mjs",
    "bench": "node bench/bench.mjs",
    "bench:golden": "node bench/golden.mjs",
    "bench:scale": "node bench/scale.mjs",
    "bench:quality": "node bench/quality.mjs",
    "bench:public": "node bench/public-retrieval.mjs",
    "bench:public:fetch": "node bench/fetch-public.mjs",
    "check": "node scripts/check-docs.mjs && node scripts/check-client-hooks.mjs && node scripts/check-syntax.mjs && node scripts/check-client-load.mjs && node scripts/check-semantic-assets.mjs && node scripts/check-launcher.mjs && node -e \"['package.json','locale/zh.json','locale/en.json'].forEach(f=>JSON.parse(require('fs').readFileSync(f,'utf8')))\" && node scripts/check-update-log.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:update-log": "node scripts/check-update-log.mjs",
    "check:launcher": "node scripts/check-launcher.mjs",
    "install:launcher": "node scripts/install-launcher.mjs",
    "uninstall:launcher": "node scripts/uninstall-launcher.mjs",
    "update-log": "node scripts/update-log.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "models",
    "hosts",
    "scripts",
    "AGENTS.md",
    ".omni-project",
    "package.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "GOVERNANCE.md",
    "ATTRIBUTION.md",
    "LICENSE",
    "docs",
    "!docs/GAP-REVIEW-*.md",
    "!docs/INTEGRATION-PROBE-*.md",
    "!docs/RECHECK-3.9.2-*.md",
    "!docs/RECHECK-3.9.3-*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "omni": {
    "launcher": {
      "path": "scripts/launchers/omni-serve-7788.exe",
      "sha256": "d7ba3e7696b2113c24c2f22f8f535b27ae38e7dd5e6cf5f7df237d0d4bb6dce4"
    }
  },
  "devDependencies": {
    "fast-check": "^4.10.3"
  }
}
